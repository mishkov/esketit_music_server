# error-only avoids retaining normal request/response data in production logs.
LOG_MODE=error-only
CORS_ALLOW_ORIGIN=http://localhost:8081

# Optional backend error reporting. Leave SENTRY_DSN empty to disable Sentry.
# In production, put these values in the service's root-owned EnvironmentFile;
# do not add .env or the DSN to a release archive.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE defaults to esketit_music_server@<git-revision> in built binaries.
# SENTRY_RELEASE=
# Optional HTTP/provider performance sampling. 0 disables traces; production can
# start with a low rate such as 0.05 and adjust for traffic and Sentry quota.
SENTRY_TRACES_SAMPLE_RATE=0

# Required for authenticated API access. Generate a unique random value with at
# least 32 characters; this deliberately short placeholder makes startup fail.
AUTH_SECRET=replace-me

# Optional storage overrides.
SONGS_DIR=/absolute/path/to/media_storage/songs
ALBUM_COVERS_DIR=/absolute/path/to/media_storage/album_covers
TRACKS_DB_PATH=tracks_db.json

# Album cover suggestions use Spotify album search by default when these are set.
SPOTIFY_CLIENT_ID=replace-with-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-spotify-client-secret
# Optional overrides for local testing or non-default deployment.
# ALBUM_COVER_SEARCH_PROVIDER=spotify
# SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
# SPOTIFY_API_BASE_URL=https://api.spotify.com/v1

# Telegram import support.
TELEGRAM_API_ID=replace-with-telegram-api-id
TELEGRAM_API_HASH=replace-with-telegram-api-hash
